# ==========================================
# SmartCompile Environment Configuration
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# SQLite Database File Path
SMARTCOMPILE_DB_PATH=smartcompile.db

# Active AI Provider: "mock", "gemini", "openai", or "anthropic"
# When set to "gemini", AI_MODEL and GEMINI_API_KEY must be provided.
AI_PROVIDER=mock

# Common AI Model ID (e.g. gemini-2.5-flash, gemini-1.5-flash, gpt-4o-mini)
# Must be set when AI_PROVIDER=gemini (no hardcoded fallback model).
AI_MODEL=gemini-2.5-flash

# Timeout and Retry Settings
AI_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
# Optional provider-specific model override (AI_MODEL takes precedence if set):
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional custom base URL (e.g. for Ollama http://localhost:11434/v1 or Groq https://api.groq.com/openai/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic Configuration ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
