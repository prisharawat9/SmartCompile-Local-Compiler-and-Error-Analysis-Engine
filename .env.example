# ==========================================
# SmartCompile Environment Configuration
# ==========================================

# Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# SQLite Database File Path
SMARTCOMPILE_DB_PATH=smartcompile.db

# Active AI Provider: "mock", "openai", "gemini", or "anthropic"
# Default is "mock" for offline college demos and automated testing.
AI_PROVIDER=mock

# --- OpenAI Configuration ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional custom base URL (e.g. for Ollama http://localhost:11434/v1 or Groq https://api.groq.com/openai/v1)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini Configuration ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# --- Anthropic Configuration ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Request Timeout in Seconds
AI_REQUEST_TIMEOUT=20.0
